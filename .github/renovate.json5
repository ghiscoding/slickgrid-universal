{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:base', 'group:allNonMajor'],
  labels: ['📦 dependencies', '🤖 bot'],
  dependencyDashboard: true,
  minimumReleaseAge: '2 days',
  // since all PRs touches the pnpm lock file, let's open not more than 2 PRs at the same time
  prConcurrentLimit: 2,
  rangeStrategy: 'bump',
  packageRules: [
    {
      depTypeList: ['peerDependencies'],
      enabled: false,
    },
    {
      description: 'Group all Angular dependencies',
      matchFileNames: ['frameworks/angular-slickgrid/**', 'demos/angular/**', 'frameworks-plugins/angular-row-detail-plugin/**'],
      groupName: 'Angular dependencies',
      ignoreDeps: ['typescript'],
      major: {
        enabled: false,
      },
    },
    // Babel new major versions fail in Angular, let's ignore those
    {
      packageNames: ['@babel/core', 'undici'],
      allowedVersions: '< 8.0.0',
    },
    // jsdom v30 seems to cause test regressions in slickgrid.ts because of `getComputedStyle()` changes
    {
      packageNames: ['jsdom'],
      allowedVersions: '< 30.0.0',
    },
    // postponed few packages to next major
    {
      packageNames: ['i18next'],
      allowedVersions: '< 26.0.0',
    },
    {
      packageNames: ['react-i18next'],
      allowedVersions: '< 17.0.0',
    },
    {
      packageNames: ['@angular-eslint/eslint-plugin'],
      allowedVersions: '< 22.0.0',
    },
    {
      // Exclude all the packages that I personally maintain from minimumReleaseAge
      matchPackagePatterns: ['^@lerna-lite/', '^@excel-builder-vanilla/types$', '^excel-builder-vanilla$', '^multiple-select-vanilla$'],
      minimumReleaseAge: '0',
    },
  ],
  ignoreDeps: ['lee-dohm/no-response', 'node', 'pnpm', 'typescript'],
  schedule: ['every 4 weeks on friday'],
}
