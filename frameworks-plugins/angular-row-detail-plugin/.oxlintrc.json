{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json"],
  "env": {
    "es2025": true,
    "browser": true,
    "shared-node-browser": true
  },
  "plugins": ["oxc", "typescript", "vitest"],
  "jsPlugins": [
    {
      "name": "angular-eslint-row-detail",
      "specifier": "@angular-eslint/eslint-plugin"
    }
  ],
  "ignorePatterns": ["**/*.spec.ts", "**/*.cy.ts", ".angular/*", "dist/", "coverage/", "test/", "**/environment.*.ts", "**/public_api.ts"],
  "rules": {
    "angular-eslint-row-detail/no-forward-ref": "error",
    "angular-eslint-row-detail/directive-selector": [
      "error",
      {
        "type": "attribute",
        "prefix": "app",
        "style": "camelCase"
      }
    ],
    "angular-eslint-row-detail/component-selector": [
      "error",
      {
        "type": "element",
        "style": "kebab-case"
      }
    ],
    "angular-eslint-row-detail/prefer-standalone": "error",
    "typescript/no-unused-expressions": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "destructuredArrayIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "typescript/consistent-type-imports": "off",
    "import/extensions": "off"
  }
}
