{
  "name": "@slickgrid-universal/pivot-plugin",
  "version": "11.0.0",
  "description": "Pivot table external resource for SlickGrid Universal",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./dist/styles/*": "./dist/styles/*"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist",
    "/src"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc && pnpm run sass:bundle",
    "build:incremental": "tsc --incremental --declaration",
    "clean": "remove dist tsconfig.tsbuildinfo",
    "dev": "pnpm build:incremental && pnpm run sass:bundle",
    "sass:bundle": "node ../../scripts/build-package-styles.mjs src/styles/slick.pivot.scss"
  },
  "license": "MIT",
  "author": "Ghislain B.",
  "homepage": "https://github.com/ghiscoding/slickgrid-universal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghiscoding/slickgrid-universal.git",
    "directory": "packages/pivot-plugin"
  },
  "bugs": {
    "url": "https://github.com/ghiscoding/slickgrid-universal/issues"
  },
  "dependencies": {
    "@slickgrid-universal/common": "workspace:*",
    "@slickgrid-universal/binding": "workspace:*",
    "@slickgrid-universal/utils": "workspace:*"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "cssnano": "^9.9.0",
    "postcss": "catalog:",
    "sass": "catalog:"
  },
  "browserslist": [
    "baseline widely available"
  ]
}
