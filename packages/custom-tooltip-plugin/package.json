{
  "name": "@slickgrid-universal/custom-tooltip-plugin",
  "version": "10.11.2",
  "description": "A plugin to add Custom Tooltip when hovering a cell, it subscribes to the cell",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist",
    "/src"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc && pnpm run sass:bundle",
    "build:incremental": "tsc --incremental --declaration",
    "clean": "remove dist tsconfig.tsbuildinfo",
    "dev": "pnpm build:incremental && pnpm run sass:bundle",
    "sass:bundle": "node ../../scripts/build-package-styles.mjs --name slick-custom-tooltip"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "license": "MIT",
  "author": "Ghislain B.",
  "homepage": "https://github.com/ghiscoding/slickgrid-universal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghiscoding/slickgrid-universal.git",
    "directory": "packages/custom-tooltip-plugin"
  },
  "bugs": {
    "url": "https://github.com/ghiscoding/slickgrid-universal/issues"
  },
  "dependencies": {
    "@slickgrid-universal/binding": "workspace:*",
    "@slickgrid-universal/common": "workspace:*",
    "@slickgrid-universal/utils": "workspace:*"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.1",
    "cssnano": "^9.1.1",
    "postcss": "^8.5.28",
    "sass": "catalog:"
  }
}