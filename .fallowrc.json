{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.ts",
    "src/main.ts"
  ],
  "ignorePatterns": [
    "**/package.json",
    "**/__tests__/**",
    "**/demos/**",
    "**/*.{cy,spec}.ts"
  ],
  "workspaces": {
    "packages": [
      "frameworks/**",
      "frameworks-plugins/**",
      "packages/**",
      "!**/dist/**"
    ]
  },
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unlisted-dependencies": "off",
    "unused-class-members": "off",
    "unused-component-outputs": "off",
    "unused-dependencies": "warn"
  }
}