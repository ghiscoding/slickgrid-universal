{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app"
  },
  "angularCompilerOptions": {
    "compilationMode": "full",
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    },
    "preserveWhitespaces": true,
    "strictMetadataEmit": true
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"]
}
